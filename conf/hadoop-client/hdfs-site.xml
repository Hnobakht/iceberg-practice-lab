<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <!-- One DataNode, so replication must be 1. -->
  <property>
    <name>dfs.replication</name>
    <value>1</value>
  </property>

  <!-- NameNode metadata directory. -->
  <property>
    <name>dfs.namenode.name.dir</name>
    <value>file:///hadoop/dfs/name</value>
  </property>

  <!-- DataNode block storage directory. -->
  <property>
    <name>dfs.datanode.data.dir</name>
    <value>file:///hadoop/dfs/data</value>
  </property>


  <property>
    <name>dfs.datanode.data.dir.perm</name>
    <value>777</value>
  </property>

  <!-- Bind NameNode RPC to all container interfaces. -->
  <property>
    <name>dfs.namenode.rpc-bind-host</name>
    <value>0.0.0.0</value>
  </property>

  <property>
    <name>dfs.namenode.rpc-address</name>
    <value>hdfs-namenode:9000</value>
  </property>

  <!-- Bind NameNode HTTP UI. -->
  <property>
    <name>dfs.namenode.http-bind-host</name>
    <value>0.0.0.0</value>
  </property>

  <property>
    <name>dfs.namenode.http-address</name>
    <value>hdfs-namenode:9870</value>
  </property>

  <!-- Bind DataNode HTTP UI. -->
  <property>
    <name>dfs.datanode.http.address</name>
    <value>0.0.0.0:9864</value>
  </property>

  <!-- Bind DataNode data transfer port. -->
  <property>
    <name>dfs.datanode.address</name>
    <value>0.0.0.0:9866</value>
  </property>

  <!-- Bind DataNode IPC port. -->
  <property>
    <name>dfs.datanode.ipc.address</name>
    <value>0.0.0.0:9867</value>
  </property>

  <!-- Local lab only: disable HDFS permissions to avoid user mismatch issues. -->
  <property>
    <name>dfs.permissions.enabled</name>
    <value>false</value>
  </property>

  <!-- Docker network clients should use container service names, not hostnames from outside Docker. -->
  <property>
    <name>dfs.client.use.datanode.hostname</name>
    <value>false</value>
  </property>

  <property>
    <name>dfs.datanode.use.datanode.hostname</name>
    <value>false</value>
  </property>

  <!-- Keep block size small for tiny local test files. -->
  <property>
    <name>dfs.blocksize</name>
    <value>134217728</value>
  </property>

  <!-- Avoid strict hostname checks in local Docker. -->
  <property>
    <name>dfs.namenode.datanode.registration.ip-hostname-check</name>
    <value>false</value>
  </property>
</configuration>